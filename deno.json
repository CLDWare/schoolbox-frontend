{
  "tasks": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package jj&& publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "imports": {
    "@sveltejs/kit": "npm:@sveltejs/kit@^2.49.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.17",
    "svelte": "npm:svelte@^5.45.6",
    "tailwindcss": "npm:tailwindcss@^4.1.17",
    "@sveltejs/adapter-auto": "npm:@sveltejs/adapter-auto@^6.1.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^6.2.1",
    "svelte-check": "npm:svelte-check@^4.3.4",
    "typescript": "npm:typescript@^5.9.3",
    "vite": "npm:vite@^7.2.7"
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"],
      "include": [
        "camelCase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-const-reassign",
        "no-eval"
      ]
    }
  }
}
