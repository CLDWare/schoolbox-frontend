{
  "tasks": {
    "dev": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite",
    "build": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite build",
    "preview": "deno run -A --unstable-detect-cjs --node-modules-dir npm:vite preview"
  },
  "imports": {
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.10.2",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.18",
    "daisyui": "npm:daisyui@^5.5.14",
    "preact": "npm:preact@^10.26.9",
    "preact-iso": "npm:preact-iso@^2.11.1",
    "tailwindcss": "npm:tailwindcss@^4.1.18",
    "typescript": "npm:typescript@^5.9.3",
    "vite": "npm:vite@^7.0.4"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}